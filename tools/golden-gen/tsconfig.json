{
  "$schema": "https://json.schemastore.org/tsconfig",
  "docs": [
    "No references: this reads a JSONL file and writes a JSON file, and shares no code",
    "with infra or the core."
  ],

  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/.tsbuildinfo",
    "types": ["node"]
  },
  "include": ["src/**/*.ts", "test/**/*.ts"]
}
