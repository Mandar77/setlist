{
  "name": "setlist",
  "private": true,
  "type": "module",
  "description": "Turn a photo or a pasted list of songs into a playlist. Serverless, $0/month.",
  "license": "MIT",
  "packageManager": "pnpm@11.0.9",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --build --verbose",
    "typecheck:clean": "tsc --build --clean",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "22.10.2",
    "eslint": "9.17.0",
    "eslint-config-prettier": "9.1.0",
    "globals": "15.14.0",
    "prettier": "3.9.9",
    "typescript": "5.7.2",
    "typescript-eslint": "8.71.0",
    "vitest": "2.1.8"
  },
  "pnpm": {
    "onlyBuiltDependencies": []
  }
}
