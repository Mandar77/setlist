		"issueType": "IncorrectValue",
		"keyExpectedValue": sprintf("Resources.%s should not cost money under profile=zero (SZC-LAMBDA-IMAGE)", [name]),
		"keyActualValue": sprintf("Resources.%s is billable: An image package needs an ECR repository, billed per GB-month after the first year. Zip packaging has no storage charge.", [name]),
	}
}
