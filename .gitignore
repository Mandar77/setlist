# Editors / OS
.DS_Store
Thumbs.db
*.swp

# Consented golden data (ADR-006). This repository is PUBLIC: plaintext scans of
# people's handwriting must never be committed. Only the age-encrypted .age files and
# the pointer indexes are tracked.
golden/private/incoming/
golden/private/**/*.jpg
golden/private/**/*.jpeg
golden/private/**/*.png
golden/private/**/*.heic
golden/private/**/*.webp
!golden/private/**/*.age
!golden/private/**/INDEX.md

# Generated golden data - CI regenerates it deterministically from the seed catalog.
golden/ocr-generated/

# Downloaded tooling: the pinned 2MS binary the pre-push gate fetches.
# 13 MB, reproducible from the pinned tag, and platform-specific.
.cache/

# Local scratch
.scratch/
tmp/

# Editor-local
.vscode/

# Node / pnpm
node_modules/
*.tsbuildinfo

# CDK synthesis output
cdk.out/
.kics-samples/

# Scratch resume state for the seed harvest. The rows file beside it is the artifact
# and is committed; this is the bookmark, and it is deleted when a harvest completes.
golden/seed/.harvest-state.json
