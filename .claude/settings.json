{
  "permissions": {
    "deny": [
      "Bash(aws *)",
      "Bash(sam deploy *)",
      "Bash(cdk deploy *)",
      "Bash(cdk destroy *)",
      "Bash(npx cdk deploy *)",
      "Bash(npx cdk destroy *)",
      "Bash(pnpm cdk deploy *)",
      "Bash(pnpm exec cdk deploy *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push --force-with-lease *)",
      "Bash(gh pr merge *)",
      "Bash(gh secret *)",
      "Bash(gh repo delete *)",
      "Bash(gh repo edit *)",
      "Bash(gh release delete *)",
      "Read(./secrets/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'root=\"${CLAUDE_PROJECT_DIR:-$(git rev-parse --show-toplevel)}\"; exec bash \"$root/.claude/hooks/guard-bash.sh\"'"
          }
        ]
      }
    ]
  }
}
